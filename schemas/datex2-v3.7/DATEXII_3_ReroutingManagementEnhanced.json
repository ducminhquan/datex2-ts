        "specificDestinationFacility": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/SpecificDestinationFacility"
        },
        "ptRouteSchedule": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/PtSchedule"
          },
          "minItems": 0
        },
        "capacityManagementMeasure": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/CapacityManagementMeasure"
          },
          "minItems": 0
        },
        "supplementaryPositionalDescription": {
          "$ref": "DATEXII_3_LocationReferencing.json#/$defs/SupplementaryPositionalDescription"
        },
        "abnormalTraffic": {
          "$ref": "DATEXII_3_Situation.json#/$defs/AbnormalTraffic"
        },
        "routeDelays": {
          "$ref": "DATEXII_3_Situation.json#/$defs/Delays"
        },
        "trafficStatus": {
          "$ref": "DATEXII_3_RoadTrafficData.json#/$defs/TrafficStatusValue"
        },
        "travelTimeData": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_RoadTrafficData.json#/$defs/TravelTimeData"
          },
          "minItems": 0
        },
        "rerRouteDescriptionExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      }
    },
    "SpecificDestinationFacility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idG": {
          "type": "string"
        },
        "versionG": {
          "type": "string"
        },
        "name": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
        },
        "alias": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
          },
          "minItems": 0

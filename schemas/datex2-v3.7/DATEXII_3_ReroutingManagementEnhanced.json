        "type": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/FacilityTypeEnumG"
        },
        "otherSpecificDestinationFacility": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"

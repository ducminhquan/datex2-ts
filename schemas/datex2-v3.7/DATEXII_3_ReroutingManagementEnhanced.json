      "type": "string",
      "enum": [
        "additionalParkingBan",
        "alteredSignalPhasing",
        "alternatedSignalisedTraffic",
        "closedEntry",
        "closedExit",
        "closedLanes",
        "modifiedCycleLength",
        "modifiedGreenPeriod",
        "oneDirectionTraffic",
        "oneDirectionTrafficReversed",
        "openedExtraLane",
        "reducingLocalAccess",
        "synchronizedTrafficSignals",
        "other",
        "extendedG"
      ]
    },
    "CapacityManagementActionEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/CapacityManagementActionEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "CapacityManagementMeasure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measure": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/CapacityManagementMeasureEnumG"
        },
        "action": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/CapacityManagementActionEnumG"
          },
          "minItems": 0
        },
        "description": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
        },
        "defaultGreenTimeAdjustment": {
          "$ref": "DATEXII_3_Common.json#/$defs/Seconds"
        },
        "defaultCycleLength": {
          "$ref": "DATEXII_3_Common.json#/$defs/Seconds"
        },
        "recommendedSpeed": {
          "$ref": "DATEXII_3_Common.json#/$defs/KilometresPerHour"
        },
        "affectedLocation": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_LocationReferencing.json#/$defs/LocationReferenceG"
          },
          "minItems": 0
        },
        "trafficSignal": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/TrafficSignal"

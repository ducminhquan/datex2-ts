      "type": "string",
      "enum": [
        "carPark",
        "parking",
        "publicTransport",
        "parkAndDrive",
        "parkAndRide",
        "parkAndCycle",
        "parkAndWalk",
        "kissAndRide",
        "liftshare",
        "carSharing",
        "restArea",
        "serviceArea",
        "eventParking",
        "dropOff",
        "overnightParking",
        "pointOfInterest",
        "other",
        "extendedG"
      ]
    },
    "FacilityTypeEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/FacilityTypeEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "OccupantCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "negate": {
          "$ref": "DATEXII_3_Common.json#/$defs/Boolean"

        "rerDetailedAllocation": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/DetailedAllocation"
        },
        "rerBasicAllocation": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/BasicAllocation"
        }
      }
    },
    "RouteDescription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nameOfRoute": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"

        "routingThrough": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_LocationReferencing.json#/$defs/LocationG"
          },
          "minItems": 0
        },
        "routingDestination": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_LocationReferencing.json#/$defs/LocationG"
          },
          "minItems": 0
        },
        "originalRoute": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/RouteDescription"
        },
        "alternativeRoute": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/RouteDescription"
          },
          "minItems": 0
        }
      }
    },
    "ReroutingTypeEnum": {
      "type": "string",
      "enum": [
        "alternative",
        "kpiForNavigationServices",
        "parkAndRide",
        "parkingGuidance",
        "strategyConform",
        "urbanCompatible",
        "extendedG"
      ]
    },

          "items": {
            "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/ReroutingAdviceTypeEnumG"
          },
          "minItems": 0
        },
        "complianceOptionOverride": {
          "$ref": "DATEXII_3_Situation.json#/$defs/ComplianceOptionEnumG"
        },
        "routeEffectivlyClosedForAllocation": {
          "$ref": "DATEXII_3_Common.json#/$defs/Boolean"
        },
        "condition": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/ConditionG"
        },
        "rerRouteAllocationExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        },
        "rerBasicAllocationExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "condition"
      ]
    },
    "CapacityManagement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
        },
        "capacityManagementMeasure": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/CapacityManagementMeasure"

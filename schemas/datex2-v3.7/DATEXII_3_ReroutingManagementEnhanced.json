        "entry": {
          "$ref": "DATEXII_3_Common.json#/$defs/String"
        },
        "exit": {
          "$ref": "DATEXII_3_Common.json#/$defs/String"
        },
        "roadOrJunctionNumber": {
          "$ref": "DATEXII_3_Common.json#/$defs/String"
        },
        "trafficConstriction": {
          "$ref": "DATEXII_3_Situation.json#/$defs/TrafficConstrictionTypeEnumG"
        },
        "routeLength": {
          "$ref": "DATEXII_3_Common.json#/$defs/MetresAsNonNegativeInteger"

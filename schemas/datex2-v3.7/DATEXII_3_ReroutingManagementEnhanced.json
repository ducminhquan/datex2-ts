        "legalBasis": {
          "$ref": "DATEXII_3_TrafficRegulation.json#/$defs/LegalBasis"
        },
        "rerConditionExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        },
        "rerOccupantConditionExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      }
    },
    "PriorityIndex": {
      "$ref": "DATEXII_3_Common.json#/$defs/NonNegativeInteger",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "PtSchedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idG": {
          "type": "string"
        },
        "versionG": {
          "type": "string"
        },
        "lastUpdated": {
          "$ref": "DATEXII_3_Common.json#/$defs/DateTime"
        },
        "line": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_Common.json#/$defs/String"
          },
          "minItems": 0
        },
        "nextDepartures": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_Common.json#/$defs/Time"
          },
          "minItems": 0
        },
        "destination": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
        },
        "interval": {
          "$ref": "DATEXII_3_Common.json#/$defs/Seconds"
        },
        "travelTimeToDestination": {
          "$ref": "DATEXII_3_Common.json#/$defs/Seconds"

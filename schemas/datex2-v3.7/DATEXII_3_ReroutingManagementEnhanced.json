      "description": "Only one of the properties shall be used in an instance.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rerRouteAllocation": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/RouteAllocation"

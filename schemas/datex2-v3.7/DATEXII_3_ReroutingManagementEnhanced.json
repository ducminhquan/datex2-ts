        "description": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
        },
        "accessibility": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_Facilities.json#/$defs/AccessibilityEnumG"

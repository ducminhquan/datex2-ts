        "rerCapacityManagementMeasureExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "measure"
      ]
    },
    "CapacityManagementMeasureEnum": {
      "type": "string",
      "enum": [
        "accessMeasures",
        "capacityIncrease",
        "capacityReduction",
        "inflowReduction",
        "outflowIncrease",
        "parkingMeasures",
        "signalMeasures",
        "other",
        "extendedG"
      ]
    },
    "CapacityManagementMeasureEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_ReroutingManagementEnhanced.json#/$defs/CapacityManagementMeasureEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },

        "startOfNumericCode": {
          "$ref": "DATEXII_3_Common.json#/$defs/NonNegativeInteger"
        },
        "comxNumberPlateCharacteristicsExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      }
    },
    "NumericalEmissionValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emissionType": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EmissionTypeEnumG"
        },
        "value": {
          "$ref": "DATEXII_3_Common.json#/$defs/Float"
        },
        "comparisonOperator": {
          "$ref": "DATEXII_3_Common.json#/$defs/ComparisonOperatorEnumG"
        },
        "comxNumericalEmissionValuesExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      }
    },
    "OwnerCharacteristic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerType": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/OwnerTypeEnumG"
        },
        "locationOfResidency": {
          "$ref": "DATEXII_3_LocationReferencing.json#/$defs/LocationReferenceG"

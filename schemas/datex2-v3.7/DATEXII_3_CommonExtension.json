        },
        "ageCharacteristic": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_CommonExtension.json#/$defs/AgeCharacteristic"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "maximumDesignSpeed": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/Speed"
        },
        "trailerCharacteristics": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/TrailerCharacteristics"
        },
        "hazardousMaterials": {

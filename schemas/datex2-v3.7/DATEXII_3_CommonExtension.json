{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ADRClass": {
      "$ref": "DATEXII_3_Common.json#/$defs/String",
      "pattern": "[1-9]|[4-6].[1-2]|4.3"
    },
    "AgeCharacteristic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparisonOperator": {
          "$ref": "DATEXII_3_Common.json#/$defs/ComparisonOperatorEnumG"
        },
        "yearOfFirstRegistration": {
          "$ref": "DATEXII_3_Common.json#/$defs/Year"
        },
        "yearOfLastRegistration": {
          "$ref": "DATEXII_3_Common.json#/$defs/Year"
        },
        "vehicleAge": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/NonNegativeIntegerComparison"
        },
        "comxAgeCharacteristicExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "comparisonOperator"
      ]
    },
    "ApplicableDaysWithinMonthEnum": {
      "type": "string",
      "enum": [
        "daysFromOneToFifteen",
        "daysFromSixteenToThirtyOne",
        "evenDay",
        "oddDay",
        "extendedG"
      ]
    },
    "ApplicableDaysWithinMonthEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/ApplicableDaysWithinMonthEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "DangerousGoodsExtended": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chemicalName": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
        },
        "dangerousGoodsFlashPoint": {
          "$ref": "DATEXII_3_Common.json#/$defs/TemperatureCelsius"
        },
        "dangerousGoodsRegulations": {
          "$ref": "DATEXII_3_Common.json#/$defs/DangerousGoodsRegulationsEnumG"
        },
        "hazardCodeIdentification": {
          "$ref": "DATEXII_3_Common.json#/$defs/String"
        },
        "hazardCodeVersionNumber": {
          "$ref": "DATEXII_3_Common.json#/$defs/NonNegativeInteger"
        },
        "hazardSubstanceItemPageNumber": {
          "$ref": "DATEXII_3_Common.json#/$defs/String"
        },
        "tremCardNumber": {
          "$ref": "DATEXII_3_Common.json#/$defs/String"
        },
        "undgNumber": {
          "$ref": "DATEXII_3_Common.json#/$defs/String"
        },
        "volumeOfDangerousGoods": {
          "$ref": "DATEXII_3_Common.json#/$defs/CubicMetres"
        },
        "weightOfDangerousGoods": {
          "$ref": "DATEXII_3_Common.json#/$defs/Tonnes"
        },
        "adrClassValue": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_CommonExtension.json#/$defs/ADRClass"
          },
          "minItems": 0,
          "maxItems": 13
        },
        "comHazardousMaterialsExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        },
        "comxDangerousGoodsExtendedExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "chemicalName"
      ]
    },
    "DayWeekMonthExtended": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicableDaysWithinMonth": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/ApplicableDaysWithinMonthEnumG"
        }
      },
      "required": [
        "applicableDaysWithinMonth"
      ]
    },
    "EmissionsExtension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparisonOperator": {
          "$ref": "DATEXII_3_Common.json#/$defs/ComparisonOperatorEnumG"
        }
      },
      "required": [
        "comparisonOperator"
      ]
    },
    "EmissionTypeEnum": {
      "type": "string",
      "enum": [
        "co2",
        "nox",
        "pm",
        "extendedG"
      ]
    },
    "EmissionTypeEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EmissionTypeEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "EnginePowerCharacteristics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparisonOperator": {
          "$ref": "DATEXII_3_Common.json#/$defs/ComparisonOperatorEnumG"
        },
        "enginePower": {
          "$ref": "DATEXII_3_Common.json#/$defs/Float"
        },
        "unitOfMeasure": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/PowerUnitOfMeasureEnumG"
        },
        "comxEnginePowerCharacteristicsExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "comparisonOperator",
        "enginePower",
        "unitOfMeasure"
      ]
    },
    "EngineTypeEnum": {
      "type": "string",
      "enum": [
        "electricMotor",
        "hybrid",
        "internalCombustionEngine",
        "other",
        "extendedG"
      ]
    },
    "EngineTypeEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EngineTypeEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "EuBodyworkCodeEnum": {
      "type": "string",
      "enum": [
        "aa",
        "ab",
        "ac",
        "ad",
        "ae",
        "af",
        "ag",
        "ba",
        "bb",
        "bc",
        "bd",
        "be",
        "bx",
        "ca",
        "cb",
        "cc",
        "cd",
        "ce",
        "cf",
        "cg",
        "ch",
        "ci",
        "cj",
        "cx",
        "da",
        "db",
        "dc",
        "de",
        "extendedG"
      ]
    },
    "EuBodyworkCodeEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuBodyworkCodeEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "EuBodyworkSupplementaryDigit": {
      "type": "string",

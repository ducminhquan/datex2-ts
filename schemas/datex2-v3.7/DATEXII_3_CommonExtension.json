    "EuSpecialPurposeVehicleEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuSpecialPurposeVehicleEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "EuVehicleCategoryEnum": {
      "type": "string",
      "enum": [
        "l1",
        "l2",
        "l3",
        "l4",
        "l5",
        "l6",
        "l7",
        "m",
        "r",
        "r1",
        "r2",
        "r3",
        "r4",
        "t1",
        "t2",
        "t3",
        "t4",
        "t41",
        "t42",
        "t43",
        "m1",
        "m2",
        "m3",
        "n",
        "n1",
        "n2",
        "n3",
        "o",
        "o1",
        "o2",
        "o3",
        "o4",
        "extendedG"

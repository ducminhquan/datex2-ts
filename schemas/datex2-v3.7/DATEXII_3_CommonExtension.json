      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuVehicleCategoryEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]

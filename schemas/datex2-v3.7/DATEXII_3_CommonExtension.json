    "OwnerTypeEnum": {
      "type": "string",
      "enum": [
        "localBusiness",
        "ownerOfLocalProperty",
        "permanentResident",
        "extendedG"
      ]
    },
    "OwnerTypeEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/OwnerTypeEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "PeriodExtended": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fuzzyPeriod": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_CommonExtension.json#/$defs/FuzzyPeriod"
          },
          "minItems": 0
        }
      }
    },
    "PortNumber": {
      "$ref": "DATEXII_3_Common.json#/$defs/NonNegativeInteger",
      "minimum": 0.0,
      "maximum": 65535.0
    },
    "PowerUnitOfMeasureEnum": {
      "type": "string",
      "enum": [
        "horsepower",
        "kilowatt",
        "extendedG"
      ]
    },
    "PowerUnitOfMeasureEnumG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/PowerUnitOfMeasureEnum"
        },
        "extendedValueG": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "RegulatedCharacteristics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "euVehicleCategory": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuVehicleCategoryEnumG"
          },
          "minItems": 0
        },
        "euSpecialPurposeVehicle": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuSpecialPurposeVehicleEnumG"
        },
        "nationalSpecialPurposeVehicle": {
          "$ref": "DATEXII_3_Common.json#/$defs/MultilingualString"
        },
        "offroadVehicle": {
          "$ref": "DATEXII_3_Common.json#/$defs/Boolean"
        },
        "specialPurposeVehicle": {
          "$ref": "DATEXII_3_Common.json#/$defs/Boolean"
        },
        "euBodyworkCode": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuBodyworkCodeEnumG"
        },
        "euBodyworkSupplementaryDigit": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuBodyworkSupplementaryDigitG"
        },
        "comxRegulatedCharacteristicsExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      }
    },
    "Speed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numericValue": {
          "$ref": "DATEXII_3_Common.json#/$defs/Decimal"
        },
        "unitOfMeasure": {
          "$ref": "DATEXII_3_TrafficRegulation.json#/$defs/UnitOfSpeedEnumG"
        },
        "comxSpeedExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      },
      "required": [
        "numericValue",
        "unitOfMeasure"

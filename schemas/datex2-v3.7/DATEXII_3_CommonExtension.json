        },
        "ownerCharacteristic": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/OwnerCharacteristic"
        },
        "numberPlateCharacteristics": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/NumberPlateCharacteristics"
        },
        "enginePowerCharacteristics": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_CommonExtension.json#/$defs/EnginePowerCharacteristics"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "numericalEmissionValues": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_CommonExtension.json#/$defs/NumericalEmissionValues"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "vehicleRegistrationCharacteristics": {

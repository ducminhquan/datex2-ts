        "digit19",
        "digit20",
        "digit21",
        "digit22",
        "digit23",
        "digit24",
        "digit25",
        "digit26",
        "digit27",
        "digit28",
        "digit29",
        "digit30",
        "digit31",
        "digit99",
        "extendedG"
      ]

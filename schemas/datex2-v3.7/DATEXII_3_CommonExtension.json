    "TrailerCharacteristics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grossTrailerWeightCharacteristics": {
          "type": "array",
          "items": {
            "$ref": "DATEXII_3_CommonExtension.json#/$defs/GrossTrailerWeightCharacteristics"
          },
          "minItems": 0,
          "maxItems": 2
        },
        "comxTrailerCharacteristicsExtensionG": {
          "$ref": "DATEXII_3_Common.json#/$defs/ExtensionTypeG"
        }
      }
    },
    "VehicleCharacteristicsExtended": {
      "type": "object",

        "motorCaravan",
        "armouredVehicle",
        "ambulance",
        "hearse",
        "trailerCaravan",
        "mobileCrane",
        "otherSpecialPurposeVehicle",
        "wheelChairAccessibleVehicle",
        "extendedG"
      ]

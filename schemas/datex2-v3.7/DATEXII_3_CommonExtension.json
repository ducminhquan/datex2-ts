    "EuBodyworkSupplementaryDigitG": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "DATEXII_3_CommonExtension.json#/$defs/EuBodyworkSupplementaryDigit"
